{
  "name": "erp-desktop",
  "productName": "Eco System",
  "version": "1.0.21",
  "description": "Eco System — برنامج ويندوز لإدارة الأعمال على جهاز المحل",
  "private": true,
  "main": "main.cjs",
  "author": "ERP",
  "scripts": {
    "prepare-app": "node scripts/prepare.mjs",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win nsis",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.25.0"
  },
  "build": {
    "appId": "com.erp.desktop",
    "productName": "Eco System",
    "executableName": "ERP",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "package.json",
      "build/icon.png"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eco System",
      "artifactName": "ERP-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZeyadKhaled19",
        "repo": "erp-releases",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.25.0": true
  }
}
