# منفذ الخادم
PORT=4000

# اترك DATABASE_URL فارغًا لاستخدام PGlite (PostgreSQL مدمج) داخل مجلد data/pg
# أو ضع رابط PostgreSQL حقيقي للإنتاج:
# DATABASE_URL=postgres://erp:password@localhost:5432/erp
DATABASE_URL=

# مجلد بيانات PGlite
PGLITE_DIR=./data/pg

# مجلد النسخ الاحتياطية
BACKUP_DIR=./backups

# سر توقيع رموز الدخول — غيّره إلى قيمة عشوائية طويلة في الإنتاج
JWT_SECRET=change-me-to-a-long-random-secret

# كلمة مرور المدير الأولية (تُستخدم مرة واحدة عند إنشاء قاعدة بيانات جديدة)
ADMIN_INITIAL_PASSWORD=admin123
